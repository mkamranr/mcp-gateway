# MCP-Gateway configuration (non-secret settings). Copy to .env and adjust.
# Secrets are NOT set here. docker-compose passes them as files (see deploy/scripts/generate-secrets.sh)
# through <NAME>_FILE variables. Outside Compose you may set them directly; production rejects
# placeholders and values shorter than 32 characters.

# --- runtime ---
APP_ENV=production                 # production | test | development
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
APP_VERSION=0.1.0
PUBLIC_BASE_URL=https://mcp-gateway.internal.example   # used to build the MCP endpoint URL shown in the UI
MCP_ENDPOINT_PATH=/mcp

# --- data stores (Compose supplies these as secret files: MONGODB_URI_FILE, REDIS_URL_FILE) ---
# MONGODB_URI=mongodb://user:password@mongodb:27017/?authSource=admin
MONGODB_DATABASE=mcp_gateway
# REDIS_URL=redis://:password@redis:6379/0
# High availability (docs/high-availability.md): discover the Redis master through Sentinel.
# Password, database and rediss:// TLS still come from REDIS_URL; its host is then ignored.
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_MASTER=mgw
# REDIS_SENTINEL_PASSWORD=

# --- secrets (Compose: *_FILE). Generate with deploy/scripts/generate-secrets.sh ---
# SESSION_SECRET=            # >= 32 random characters
# DATA_ENCRYPTION_KEY=       # urlsafe-base64 of exactly 32 random bytes (AES-256-GCM)
# API_KEY_HASH_PEPPER=       # >= 32 random characters; rotating it invalidates every agent key

# --- bootstrap (first start only; ignored once a platform admin exists) ---
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=  # Compose: BOOTSTRAP_ADMIN_PASSWORD_FILE; >= 12 characters
BOOTSTRAP_TENANT_SLUG=default

# --- sessions ---
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
COOKIE_SECURE=true                 # keep true behind HTTPS; false only for local HTTP development
LOGIN_MAX_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_SECONDS=300

# --- single sign-on (OIDC; configure the IdP itself in Settings -> Single sign-on, see docs/sso.md) ---
# Redirect URI to register at the IdP: ${PUBLIC_BASE_URL}/api/v1/auth/oidc/callback
# OIDC_CA_BUNDLE_FILE=/run/secrets/idp_ca.pem   # PEM bundle if the IdP uses an internal CA

# --- agent client certificates (mTLS; docs/mtls.md) ---
# Off unless MTLS_CLIENT_CA_FILE is set. Only the TLS proxy may forward a certificate: with the bundled nginx
# that is the edge network (MGW_EDGE_SUBNET below).
# MTLS_CLIENT_CA_FILE=/run/secrets/agent_ca
# MTLS_TRUSTED_PROXIES=172.31.250.0/24
# MTLS_CLIENT_CERT_HEADER=x-client-cert
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_ALLOW_INSECURE_HTTP=false     # http:// issuers; ignored when APP_ENV=production

# --- tool execution limits ---
DEFAULT_TOOL_TIMEOUT_SECONDS=30
MAX_TOOL_TIMEOUT_SECONDS=300
MAX_INPUT_BYTES=1048576
MAX_OUTPUT_BYTES=4194304
MAX_JSON_DEPTH=32
MAX_STRING_LENGTH=100000
MAX_ARRAY_LENGTH=10000
MAX_CONCURRENT_CALLS_PER_AGENT=10
MAX_REQUEST_BODY_BYTES=2097152
APPROVAL_DEFAULT_TTL_MINUTES=60

# --- network / SSRF controls (comma-separated lists) ---
ALLOW_PRIVATE_UPSTREAM_NETWORKS=false   # per-server opt-in is also required
# Comma-separated, e.g. hr-mcp.internal.example,*.mcp.internal.example. Empty = any public host.
# (Keep comments on their own line: Compose reads "VAR=   # text" as the value "# text".)
UPSTREAM_HOST_ALLOWLIST=
# Absolute paths, comma-separated. Empty disables stdio servers.
STDIO_EXECUTABLE_ALLOWLIST=
# Empty = same-origin only. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=

# --- audit ---
AUDIT_REQUIRED_FOR_EXECUTION=true       # fail closed when audit storage is unavailable
AUDIT_RETENTION_DAYS=365
AUDIT_EXPORT_MAX_ROWS=50000

# --- worker ---
WORKER_POLL_INTERVAL_SECONDS=2
HEALTH_CHECK_INTERVAL_SECONDS=60

# --- development only: NEVER enable in production ---
REDIS_FAIL_OPEN_DEV=false

# --- compose ---
MGW_HTTP_BIND=127.0.0.1
MGW_HTTP_PORT=8088
# MGW_EDGE_SUBNET=172.31.250.0/24   # network shared only by web-ui and gateway-api
# MGW_BACKEND_IMAGE=registry.internal.example/mcp-gateway/backend:0.1.0
# MGW_WEB_IMAGE=registry.internal.example/mcp-gateway/web-ui:0.1.0
